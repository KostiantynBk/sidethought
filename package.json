{
  "name": "sidethought",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx src/server/main.ts\" \"node --env-file-if-exists=.env node_modules/vite/bin/vite.js web\"",
    "build": "tsc -p tsconfig.build.json && vite build web",
    "start": "node --env-file-if-exists=.env dist/server/main.js --serve-static",
    "fixture:accept": "tsx scripts/fixture-accept.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "better-sqlite3": "13.0.3",
    "concurrently": "10.0.6",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
